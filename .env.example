# Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe for the browser, used for auth only.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb

# Supabase secret key (server only). NEVER prefix with NEXT_PUBLIC_.
# If your project only exposes a legacy service_role key, use
# SUPABASE_SERVICE_ROLE_KEY below instead (one or the other).
SUPABASE_SECRET_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# The site's own origin. Locally this is http://localhost:3000; in
# production set it to your deployed https URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
